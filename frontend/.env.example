# Copy this file to frontend/.env (or frontend/.env.local) for a bare
# `npm run dev` inside frontend/. Only variables prefixed with `VITE_` are
# exposed to client code — Vite inlines them into the browser bundle at
# build/serve time. Never put a secret in a VITE_ variable: it ships to
# every visitor's browser.

# Origin of the Cashmire API: scheme included, NO trailing slash and NO
# `/api` suffix (callers add the `/api/...` path themselves, see
# frontend/src/lib/api.js). The app works with this file absent, or with
# this variable unset/blank — frontend/src/lib/api.js falls back to the
# same default shown below.
VITE_API_URL=http://localhost:8000
