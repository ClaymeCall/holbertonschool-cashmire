POSTGRES_DB=cashmire
POSTGRES_USER=cashmire
POSTGRES_PASSWORD=cashmire
POSTGRES_PORT=5432

# Leave POSTGRES_HOST unset. Django auto-detects it: the `db` Compose
# hostname when reachable (running in the `api` container), else
# `localhost` (running the API locally against `docker compose up -d db`).
# Set it explicitly only to point at some other Postgres instance.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Read by the `frontend` Docker Compose service via `env_file: .env`
# (docker-compose.yml). A bare `npm run dev` run inside frontend/ does NOT
# read this file — Vite's envDir defaults to the frontend/ project root, so
# that path reads frontend/.env instead (see frontend/.env.example). Keep
# both values the same. Must be a URL the browser can reach directly (the
# browser makes the request, not the `frontend` container), so this is the
# host-published port — never `http://api:8000`.
VITE_API_URL=http://localhost:8000

# Only needed to run the agentic workflow orchestrator (agentic/orchestrator.py).
# Never commit a real key - get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: send agentic/orchestrator.py traces to Langfuse (https://cloud.langfuse.com
# or a self-hosted instance). Leave unset to run the orchestrator without tracing -
# agentic/tracing.py no-ops when these are missing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: who to attribute orchestrator runs to in Langfuse (user_id), for
# per-team-member cost/usage. Leave unset - it's picked up from this repo's
# `git config user.email` automatically. Only set this to override that, e.g.
# in CI where there's no personal git identity.
LANGFUSE_USER_ID=
