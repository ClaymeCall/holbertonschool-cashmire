POSTGRES_DB=cashmire
POSTGRES_USER=cashmire
POSTGRES_PASSWORD=cashmire
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

VITE_API_URL=http://localhost:8000

# Only needed to run the agentic workflow orchestrator (agentic/orchestrator.py).
# Never commit a real key - get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: send agentic/orchestrator.py traces to Langfuse (https://cloud.langfuse.com
# or a self-hosted instance). Leave unset to run the orchestrator without tracing -
# agentic/tracing.py no-ops when these are missing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: who to attribute orchestrator runs to in Langfuse (user_id), for
# per-team-member cost/usage. Leave unset - it's picked up from this repo's
# `git config user.email` automatically. Only set this to override that, e.g.
# in CI where there's no personal git identity.
LANGFUSE_USER_ID=
